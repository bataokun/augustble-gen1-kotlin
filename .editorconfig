# Editor config for augustble-gen1-kotlin (https://editorconfig.org)
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Batch files must keep CRLF line endings.
[*.{bat,cmd}]
end_of_line = crlf
